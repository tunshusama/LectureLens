{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pdf-lecture-notes:note:v1",
  "title": "Portable lecture note",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "profile", "source_pdf", "labels", "sections"],
  "properties": {
    "mode": {"enum": ["adaptive", "zero_foundation"], "default": "adaptive"},
    "glossary_title": {"type": "string", "minLength": 1},
    "self_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "items"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "answer", "pages"],
            "properties": {
              "question": {"type": "string", "minLength": 1},
              "answer": {"type": "string", "minLength": 1},
              "pages": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    },
    "schema_version": {"const": 1},
    "title": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "source_pdf": {"type": "string", "minLength": 1},
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outline", "key_point", "term", "translation", "explanation", "classroom_note", "example"],
      "properties": {
        "outline": {"type": "string", "minLength": 1},
        "key_point": {"type": "string", "minLength": 1},
        "term": {"type": "string", "minLength": 1},
        "translation": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 1},
        "classroom_note": {"type": "string", "minLength": 1},
        "example": {"type": "string", "minLength": 1}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "reading_guide": {"type": "string"},
    "outline": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/section"}
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "h2", "pages", "blocks"],
      "properties": {
        "kind": {"enum": ["content", "transition"], "default": "content"},
        "id": {"type": ["string", "integer"]},
        "h1": {"type": ["string", "null"]},
        "h2": {"type": "string", "minLength": 1},
        "pages": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "integer", "minimum": 1}},
        "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}}
      }
    },
    "block": {
      "oneOf": [
        {"$ref": "#/$defs/textBlock"},
        {"$ref": "#/$defs/slideBlock"},
        {"$ref": "#/$defs/formulaBlock"},
        {"$ref": "#/$defs/termsBlock"},
        {"$ref": "#/$defs/classroomBlock"},
        {"$ref": "#/$defs/learningBlock"},
        {"$ref": "#/$defs/figureBlock"},
        {"$ref": "#/$defs/codeBlock"}
      ]
    },
    "codeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "language", "code", "explanation"],
      "properties": {
        "type": {"const": "code"},
        "language": {"type": "string", "pattern": "^[a-zA-Z0-9_+-]+$"},
        "code": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "textBlock": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {"type": {"enum": ["summary", "paragraph"]}, "text": {"type": "string", "minLength": 1}}
    },
    "slideBlock": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "page", "image", "caption"],
      "properties": {
        "type": {"const": "slide"}, "page": {"type": "integer", "minimum": 1},
        "image": {"type": "string", "minLength": 1}, "caption": {"type": "string", "minLength": 1}
      }
    },
    "formulaBlock": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "latex", "symbols"],
      "properties": {
        "worked_example": {"type": "string", "minLength": 1},
        "type": {"const": "formula"}, "latex": {"type": "string", "minLength": 1},
        "symbols": {"type": "array", "items": {"$ref": "#/$defs/symbol"}}
      }
    },
    "symbol": {
      "type": "object", "additionalProperties": false,
      "required": ["symbol", "meaning"],
      "properties": {
        "symbol": {"type": "string", "minLength": 1}, "reading": {"type": "string"},
        "meaning": {"type": "string", "minLength": 1}, "example": {"type": "string"}
      }
    },
    "termsBlock": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {"type": {"const": "terms"}, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/term"}}}
    },
    "term": {
      "type": "object", "additionalProperties": false,
      "required": ["term", "translation", "explanation"],
      "properties": {
        "term": {"type": "string", "minLength": 1}, "translation": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "classroomBlock": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "text", "timestamp"],
      "properties": {
        "type": {"const": "classroom_note"}, "text": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "pattern": "^\\d{1,2}:\\d{2}(?::\\d{2})?$"}
      }
    },
    "learningBlock": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "question", "answer"],
      "properties": {
        "type": {"const": "learning_note"}, "question": {"type": "string", "minLength": 1},
        "answer": {"type": "string", "minLength": 1}
      }
    },
    "figureBlock": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "image", "caption", "explanation"],
      "properties": {
        "type": {"const": "figure"}, "image": {"type": "string", "minLength": 1},
        "caption": {"type": "string", "minLength": 1}, "explanation": {"type": "string", "minLength": 1}
      }
    }
  }
}
